---
import Base from '../layouts/Base.astro';
import { url } from '../lib/utils';
---

<Base titulo="Página no encontrada" noindex>
  <section class="portada">
    <h1>No encontré esa página</h1>
    <p class="suave">Puede que el enlace esté roto o que la página se haya movido.</p>
    <div class="acciones">
      <a class="btn btn-primario" href={url('/')}>Ir al inicio</a>
      <a class="btn" href={url('/proyectos')}>Ver proyectos</a>
    </div>
  </section>
</Base>
