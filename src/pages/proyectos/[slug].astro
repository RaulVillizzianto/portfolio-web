---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { ETIQUETA_ESTADO, ETIQUETA_TIPO, ordenarProyectos, rango, url } from '../../lib/utils';

export async function getStaticPaths() {
  const proyectos = await getCollection('proyectos');
  return proyectos.map((proyecto) => ({ params: { slug: proyecto.id }, props: { proyecto } }));
}

const { proyecto } = Astro.props;
const { data } = proyecto;
const { Content } = await render(proyecto);

const todos = ordenarProyectos(await getCollection('proyectos'));
const indice = todos.findIndex((p) => p.id === proyecto.id);
const anterior = todos[indice - 1];
const siguiente = todos[indice + 1];

const enlaces = [
  data.links.repo && { etiqueta: 'Código', url: data.links.repo },
  data.links.demo && { etiqueta: 'Demo', url: data.links.demo },
  ...(data.links.otros ?? []),
].filter((e): e is { etiqueta: string; url: string } => Boolean(e));
---

<Base titulo={data.titulo} descripcion={data.resumen} tipo="article">
  <article>
    <header class="ficha-cabecera">
      <p class="chico"><a href={url('/proyectos')}>← Proyectos</a></p>
      <h1>{data.titulo}</h1>
      <p class="resumen">{data.resumen}</p>

      <dl class="ficha-datos">
        <div>
          <dt>Rol</dt>
          <dd>{data.rol}</dd>
        </div>
        <div>
          <dt>Período</dt>
          <dd>{rango(data.inicio, data.fin)}</dd>
        </div>
        <div>
          <dt>Tipo</dt>
          <dd>{ETIQUETA_TIPO[data.tipo]}</dd>
        </div>
        <div>
          <dt>Estado</dt>
          <dd>{ETIQUETA_ESTADO[data.estado]}</dd>
        </div>
      </dl>

      <ul class="pildoras" aria-label="Tecnologías">
        {data.stack.map((s) => <li class="pildora pildora-borde">{s}</li>)}
      </ul>

      {enlaces.length > 0 && (
        <div class="acciones" style="margin-top:1rem">
          {enlaces.map((e) => (
            <a class="btn" href={e.url} rel="noopener" target="_blank">
              {e.etiqueta} ↗
            </a>
          ))}
        </div>
      )}

      {data.confidencial && (
        <p class="aviso" style="margin-top:1rem">
          Proyecto confidencial: se describe el trabajo sin nombrar al cliente ni mostrar el código.
        </p>
      )}
    </header>

    <div class="prosa">
      <Content />
    </div>
  </article>

  <nav class="seccion-cabecera" aria-label="Otros proyectos" style="margin-top:3rem">
    <span>{anterior && <a href={url(`/proyectos/${anterior.id}`)}>← {anterior.data.titulo}</a>}</span>
    <span>{siguiente && <a href={url(`/proyectos/${siguiente.id}`)}>{siguiente.data.titulo} →</a>}</span>
  </nav>
</Base>
